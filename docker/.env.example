# Sourcebook — Docker Compose settings. Copy to .env and adjust.

# Image and version (docker/build.sh tags both ghcr.io/piconem/sourcebook:<version> and :latest).
SOURCEBOOK_IMAGE=ghcr.io/piconem/sourcebook
SOURCEBOOK_VERSION=latest
SOURCEBOOK_CONTAINER_NAME=sourcebook

# Workspace folder on the host (projects, templates, accounts). Create it before the first start
# (mkdir -p data), otherwise Docker creates it owned by root and Sourcebook cannot write into it.
SOURCEBOOK_DATA=./data
# Owner of that folder: `id -u` / `id -g`.
SOURCEBOOK_UID=1000
SOURCEBOOK_GID=1000

# Where to listen on the host. 127.0.0.1 = this machine only (behind a reverse proxy); 0.0.0.0 = the network.
# One port for everything: the web interface, the REST API (/api) and the MCP server for AI assistants (/mcp).
# If you change it, change SOURCEBOOK_PUBLIC_URL too.
SOURCEBOOK_BIND=127.0.0.1
SOURCEBOOK_PORT=4000

# URL prefix when served under a path, e.g. /marco/sourcebook for https://mydomain.it/marco/sourcebook/
SOURCEBOOK_BASE_PATH=/
# Address users open in the browser, including the base path (also used in the MCP connection hints;
# https makes the session cookie Secure). E.g. https://mydomain.it/marco/sourcebook
SOURCEBOOK_PUBLIC_URL=http://127.0.0.1:4000
# true behind a reverse proxy (real client IP and https from X-Forwarded-* headers).
SOURCEBOOK_TRUST_PROXY=false

# Password of the owner account created at the first start (changed at the first sign-in).
# Empty: a random one is generated and printed in `docker compose logs sourcebook`.
SOURCEBOOK_ADMIN_PASSWORD=

TZ=Europe/Rome
