  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@sourcebook/shared": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
