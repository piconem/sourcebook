{
  "name": "@sourcebook/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing Sourcebook projects and templates to LLM assistants",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "sourcebook-mcp": "./src/stdio.ts"
  },
